# 1. Provide a Helius API key to fetch live data from the network
HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=your-key-here"

# 2. (Optional) Connect the dashboard to your own Droplet Rust Decoder instead of Helius
# DECODER_API_URL="http://your-droplet-ip:8002/api/events"
LIVE_SIGNATURE_LIMIT=4
LIVE_TRANSACTION_LIMIT=16
